@model IEnumerable<TPARCIAL.Models.Incidencia>
@{
    ViewData["Title"] = "Incidencias";
    var busqueda = ViewData["Busqueda"] as string;
}

<h1>Incidencias abiertas encontradas</h1>

<form asp-controller="Operaciones" asp-action="Incidencias" method="get" class="row g-2 my-3" role="search">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="busqueda" value="@busqueda" class="form-control"
               placeholder="Buscar por nombre de estación o descripción" aria-label="Buscar incidencias" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (!string.IsNullOrEmpty(busqueda))
        {
            <a asp-controller="Operaciones" asp-action="Incidencias" class="btn btn-outline-secondary">Limpiar</a>
        }
    </div>
</form>

@if (ViewData["ErrorBusqueda"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No hay incidencias para mostrar.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Estación</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Fecha de reporte</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Estacion?.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.Estado</td>
                    <td>@item.FechaReporte.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
}
